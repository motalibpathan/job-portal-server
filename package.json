{
  "name": "job-portal-server",
  "version": "1.0.0",
  "description": "Job portal server",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node build/server.js",
    "dev": "tsnd --respawn --transpile-only src/server.ts",
    "dev:nodemon": "nodemon",
    "tsc": "tsc",
    "clean": "rm -rf ./build && rm -f ./tsconfig.tsbuildinfo",
    "build": "yarn clean && tsc",
    "lint": "eslint . --ext .js --ext .ts",
    "lint:fix": "eslint --fix --ext .js --ext .ts",
    "migrate:create": "sh -c 'ts-node node_modules/.bin/migrate-mongo create $0 -f migrate-mongo-config.ts' ",
    "migrate:status": "ts-node node_modules/.bin/migrate-mongo status -f migrate-mongo-config.ts",
    "migrate:down": "ts-node node_modules/.bin/migrate-mongo down -f migrate-mongo-config.ts && npm run migrate:status",
    "migrate:up": "ts-node node_modules/.bin/migrate-mongo up -f migrate-mongo-config.ts && npm run migrate:status",
    "test": "ENV_FILE=.env.test NODE_OPTIONS='--max_old_space_size=8192' jest --detectOpenHandles --workerIdleMemoryLimit=1028MB -w 1 --logHeapUsage",
    "test:watch": "yarn test --watchAll",
    "test:verbose": "yarn test --verbose",
    "test:coverage": "yarn test --coverage"
  },
  "engines": {
    "node": "24.19.0"
  },
  "keywords": [
    "job-portal"
  ],
  "author": "Headless Technologies",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.186.0",
    "@aws-sdk/client-s3": "^3.414.0",
    "@aws-sdk/client-secrets-manager": "^3.414.0",
    "@aws-sdk/client-ses": "^3.414.0",
    "@aws-sdk/client-sesv2": "^3.1027.0",
    "@aws-sdk/lib-storage": "^3.414.0",
    "@google/genai": "^1.46.0",
    "@googleapis/drive": "^11.0.0",
    "@types/facebook-nodejs-business-sdk": "^22.0.0",
    "agenda": "^5.0.0",
    "axios": "^1.13.5",
    "base64url": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "country-currency-utils": "^5.0.0",
    "dialogflow": "^1.1.1",
    "dotenv": "^16.3.1",
    "exceljs": "^4.3.0",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "facebook-nodejs-business-sdk": "^22.0.2",
    "firebase-admin": "^11.10.1",
    "google-auth-library": "^9.0.0",
    "jimp": "^0.22.10",
    "jsonwebtoken": "^9.0.0",
    "jspdf": "^3.0.2",
    "jspdf-autotable": "^3.8.1",
    "line-intersect": "^3.0.0",
    "migrate-mongo": "^8.2.3",
    "moment": "^2.29.4",
    "mongodb": "^5.5.0",
    "mongoose": "^7.8.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "nodemailer": "^8.0.5",
    "pb-util": "^1.0.3",
    "prompt": "^1.3.0",
    "qrcode": "^1.5.4",
    "redis": "^4.6.11",
    "request": "^2.88.2",
    "request-ip": "^3.3.0",
    "sharp": "^0.32.5",
    "sib-api-v3-typescript": "^2.2.2",
    "socket.io": "^4.8.0",
    "sslcommerz-lts": "^1.1.0",
    "winston": "^3.10.0",
    "winston-cloudwatch": "^6.2.0",
    "yup": "^0.29.3",
    "zod": "^4.0.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.4",
    "@types/bluebird": "^3.5.39",
    "@types/cookie-parser": "^1.4.7",
    "@types/dialogflow": "0.9.4",
    "@types/express": "4.17.17",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/jspdf": "^2.0.0",
    "@types/morgan": "^1.9.5",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.6.2",
    "@types/node-cron": "^3.0.8",
    "@types/nodemailer": "^8.0.0",
    "@types/prompt": "^1.1.5",
    "@types/qrcode": "^1.5.5",
    "@types/request-ip": "^0.0.38",
    "@types/supertest": "^6.0.2",
    "@types/yup": "^0.29.6",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.2.0",
    "prettier": "^2.1.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  },
  "packageManager": "yarn@1.22.22"
}
